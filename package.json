{
	"name": "xicaflor",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "next typegen && tsc --noEmit",
		"check": "biome check && next typegen && tsc --noEmit && knip && depcruise src --config .dependency-cruiser.cjs",
		"prepare": "lefthook install",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"knip": "knip",
		"depcruise": "depcruise src --config .dependency-cruiser.cjs"
	},
	"dependencies": {
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^5.0.4",
		"dependency-cruiser": "^18.6.0",
		"knip": "^6.41.0",
		"lefthook": "^2.2.2",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.4"
	},
	"packageManager": "pnpm@12.11.2"
}
