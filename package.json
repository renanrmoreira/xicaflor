{
	"name": "xicaflor",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"start": "next start",
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "next typegen && tsc --noEmit",
		"check": "biome check && next typegen && tsc --noEmit && knip && depcruise src --config .dependency-cruiser.cjs",
		"prepare": "lefthook install",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"knip": "knip",
		"depcruise": "depcruise src --config .dependency-cruiser.cjs",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"db:start": "supabase start",
		"db:reset": "supabase db reset",
		"db:migration": "supabase migration new",
		"db:types": "supabase gen types typescript --local > src/lib/database.types.ts && biome format --write src/lib/database.types.ts",
		"db:test": "supabase test db"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "1.20.12",
		"@sentry/nextjs": "^11.7.0",
		"next": "16.4.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@sentry/cli": "^3.8.0",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^5.0.4",
		"dependency-cruiser": "^18.6.0",
		"knip": "^6.41.0",
		"lefthook": "^2.2.2",
		"supabase": "^2.121.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.4",
		"wrangler": "^4.151.0"
	},
	"packageManager": "pnpm@12.11.2"
}
